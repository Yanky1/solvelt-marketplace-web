# Base URL of the marketplace API (no trailing slash)
API_BASE_URL=http://localhost:5080
# >= 32 chars, random. Signs the session cookie and CSRF tokens. Required in production.
SESSION_COOKIE_SECRET=change-me-change-me-change-me-change-me
# >= 32 chars; same value as the API's Web__ForwardingKey; must differ from SESSION_COOKIE_SECRET. Required in production.
WEB_FORWARDING_KEY=dev-only-web-forwarding-key-not-for-production
# Public origin of this site (canonical URLs, sitemap, Origin checks)
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated IPs/IPv4 CIDRs of your own reverse proxies (empty = trust none)
TRUSTED_PROXIES=
# Seconds a sign-in stays "recent" for sensitive changes such as removing a passkey (default 600)
REAUTH_WINDOW_SECONDS=600
